var checkIfInstanceOf = function(obj, classFunction) {
    if (obj === null || obj === undefined || typeof classFunction !== "function") {
        return false;
    }

    obj = Object(obj);

    while (obj !== null) {
        if (obj === classFunction.prototype) {
            return true;
        }

        obj = Object.getPrototypeOf(obj);
    }

    return false;
};
